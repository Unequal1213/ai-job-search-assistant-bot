BOT_TOKEN=your_telegram_bot_token_here
POSTGRES_DB=job_bot
POSTGRES_USER=job_bot_user
POSTGRES_PASSWORD=replace_with_local_password
DATABASE_URL=postgresql+asyncpg://job_bot_user:replace_with_local_password@db:5432/job_bot
ENVIRONMENT=development
LOG_LEVEL=INFO
DETERMINISTIC_PROVIDER_VERSION=rules-v1
MAX_VACANCY_TEXT_CHARS=12000
MAX_COVER_LETTER_CONTEXT_CHARS=8000
MAX_MESSAGE_CHARS=12000
MAX_ACTIVE_WORKFLOWS_PER_ACTOR=1
WORKFLOW_TIMEOUT_SECONDS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS_PER_WINDOW=5
